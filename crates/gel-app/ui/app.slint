import { Button, ComboBox, StandardTableView, VerticalBox, HorizontalBox, GroupBox, Slider, LineEdit, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "OpenGel";
    preferred-width: 1120px;
    preferred-height: 780px;

    // --- state in ---
    in property <image> gel-image;
    in property <[string]> ladder-names;
    in property <[[StandardListViewItem]]> band-rows;
    in property <string> status: "Open a .gel.zip, capture, or click 'Demo annotation'.";
    in property <string> gel-type-label: "-";
    in-out property <int> selected-ladder: -1;
    in-out property <float> level: 1.0;      // display window/level (0..1)
    in-out property <string> volume-ul: "10";
    in-out property <float> rotation: 0;      // degrees, live display rotation
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in-out property <float> click-x: -1;      // last click, normalized (viewport)
    in-out property <float> click-y: -1;
    in-out property <string> ladder-ng: "500";

    // --- callbacks out ---
    callback open();
    callback save();
    callback capture();
    callback analyze();
    callback demo-annotation();
    callback measure();
    callback ladder-changed(int);
    callback compare();
    callback about();
    callback level-changed();
    callback rotate(float);
    callback auto-straighten();
    callback add-lane();
    callback del-lane();
    callback toggle-ladder();
    callback add-band();
    callback del-band();
    callback calibrate();

    // Reset view (fit).
    function fit-view() {
        root.zoom = 1.0;
        root.pan-x = 0px;
        root.pan-y = 0px;
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open…"; activated => { root.open(); } }
            MenuItem { title: "Save"; activated => { root.save(); } }
        }
        Menu {
            title: "Capture";
            MenuItem { title: "Capture from camera"; activated => { root.capture(); } }
        }
        Menu {
            title: "View";
            MenuItem { title: "Zoom in"; activated => { root.zoom = min(8.0, root.zoom * 1.25); } }
            MenuItem { title: "Zoom out"; activated => { root.zoom = max(0.2, root.zoom / 1.25); } }
            MenuItem { title: "Fit"; activated => { root.fit-view(); } }
            MenuItem { title: "Auto-straighten"; activated => { root.auto-straighten(); } }
        }
        Menu {
            title: "Analyze";
            MenuItem { title: "Demo annotation"; activated => { root.demo-annotation(); } }
            MenuItem { title: "Measure regions"; activated => { root.measure(); } }
            MenuItem { title: "Detect lanes & bands"; activated => { root.analyze(); } }
            MenuItem { title: "Compare two bands"; activated => { root.compare(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About OpenGel"; activated => { root.about(); } }
        }
    }

    HorizontalBox {
        // ---- left: toolbar + image ----
        VerticalBox {
            HorizontalBox {
                Button { text: "Open…"; clicked => { root.open(); } }
                Button { text: "Capture"; clicked => { root.capture(); } }
                Button { text: "Demo annotation"; clicked => { root.demo-annotation(); } }
                Button { text: "Measure"; clicked => { root.measure(); } }
                Button { text: "Save"; clicked => { root.save(); } }
            }
            HorizontalBox {
                Text { text: "Zoom"; vertical-alignment: center; }
                Button { text: "−"; clicked => { root.zoom = max(0.2, root.zoom / 1.25); } }
                Button { text: "+"; clicked => { root.zoom = min(8.0, root.zoom * 1.25); } }
                Button { text: "Fit"; clicked => { root.fit-view(); } }
                Text { text: Math.round(root.zoom * 100) + "%"; vertical-alignment: center; }
            }

            // Zoom / pan / rotate viewport.
            Rectangle {
                background: #1c1c1c;
                border-width: 1px;
                border-color: #444;
                vertical-stretch: 1;
                clip: true;

                // Zoom + pan container; the gel image (with overlays composited
                // in) rotates live via the Image's rotation-angle.
                Rectangle {
                    width: parent.width * root.zoom;
                    height: parent.height * root.zoom;
                    x: (parent.width - self.width) / 2 + root.pan-x;
                    y: (parent.height - self.height) / 2 + root.pan-y;

                    Image {
                        source: root.gel-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                        transform-rotation: root.rotation * 1deg;
                    }
                }

                // Pointer layer (topmost) for pan / zoom / click.
                ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    property <length> start-pan-x;
                    property <length> start-pan-y;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.start-pan-x = root.pan-x;
                            self.start-pan-y = root.pan-y;
                        }
                    }
                    moved => {
                        root.pan-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                        root.pan-y = self.start-pan-y + (self.mouse-y - self.pressed-y);
                    }
                    scroll-event(e) => {
                        root.zoom = max(0.2, min(8.0, root.zoom * (1.0 + (e.delta-y / 1px) / 400)));
                        return EventResult.accept;
                    }
                    clicked => {
                        root.click-x = self.mouse-x / self.width;
                        root.click-y = self.mouse-y / self.height;
                    }
                }
            }

            HorizontalBox {
                Text { text: "Level"; vertical-alignment: center; }
                Slider {
                    minimum: 0.05; maximum: 1.0; value <=> root.level;
                    changed(v) => { root.level-changed(); }
                }
                Text { text: "Rotate"; vertical-alignment: center; }
                Slider {
                    minimum: -50; maximum: 50; value <=> root.rotation;
                    changed(v) => { root.rotate(v); }
                }
                Button { text: "Auto"; clicked => { root.auto-straighten(); } }
            }
        }

        // ---- right: controls + table ----
        ScrollView {
            width: 400px;
            VerticalBox {
                GroupBox {
                    title: "Gel";
                    VerticalBox {
                        Text { text: "Type: " + root.gel-type-label; }
                        Text { text: "Ladder:"; }
                        ComboBox {
                            model: root.ladder-names;
                            current-index <=> root.selected-ladder;
                            selected(name) => { root.ladder-changed(self.current-index); }
                        }
                    }
                }
                GroupBox {
                    title: "Edit (click image first)";
                    VerticalBox {
                        HorizontalBox {
                            Button { text: "Add lane"; clicked => { root.add-lane(); } }
                            Button { text: "Del lane"; clicked => { root.del-lane(); } }
                            Button { text: "Ladder?"; clicked => { root.toggle-ladder(); } }
                        }
                        HorizontalBox {
                            Button { text: "Add band"; clicked => { root.add-band(); } }
                            Button { text: "Del band"; clicked => { root.del-band(); } }
                        }
                    }
                }
                GroupBox {
                    title: "Quantify";
                    VerticalBox {
                        HorizontalBox {
                            Text { text: "Ladder load (ng):"; vertical-alignment: center; }
                            LineEdit { text <=> root.ladder-ng; }
                        }
                        HorizontalBox {
                            Text { text: "Volume (µL):"; vertical-alignment: center; }
                            LineEdit { text <=> root.volume-ul; }
                        }
                        Button { text: "Calibrate (absolute ng / nmol)"; clicked => { root.calibrate(); } }
                        Button { text: "Compare first two bands"; clicked => { root.compare(); } }
                    }
                }
                GroupBox {
                    title: "Bands";
                    StandardTableView {
                        min-height: 240px;
                        columns: [
                            { title: "Lane" },
                            { title: "Rf" },
                            { title: "Size" },
                            { title: "Density" },
                            { title: "ng" },
                            { title: "nmol" },
                        ];
                        rows: root.band-rows;
                    }
                }
            }
        }
    }

    // status bar
    Rectangle {
        y: parent.height - 24px;
        height: 24px;
        width: 100%;
        background: #101010;
        Text {
            text: root.status;
            color: #ddd;
            vertical-alignment: center;
            x: 8px;
        }
    }
}
