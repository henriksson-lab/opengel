import { Button, ComboBox, VerticalBox, HorizontalBox, GroupBox, Slider, LineEdit, ScrollView, TabWidget, CheckBox } from "std-widgets.slint";
import { LaneItem, TracePath, TreeRow, AxisTick, WarpKnot, FaultItem, ChannelItem, MetaRow, StatusChip, TabButton } from "common.slint";
import { GelTab } from "gel.slint";
import { TraceTab } from "trace.slint";
import { MetadataTab } from "metadata.slint";
import { CaptureTab } from "capture.slint";











export component AppWindow inherits Window {
    title: "OpenGel";
    preferred-width: 1180px;
    preferred-height: 820px;

    // --- state in ---
    in property <image> gel-image;
    in property <image> histogram-image;
    in property <[string]> file-names;
    in-out property <int> file-index: -1;
    in property <bool> has-open-file: false;
    in property <bool> active-file-dirty: false;
    in property <[string]> ladder-vendor-names;
    in property <[string]> ladder-names;
    in property <[string]> frame-names;
    in property <[TreeRow]> tree-rows;
    in property <int> selected-lane-id: -1;       // selected lane (or a selected band's lane), -1 = none
    in property <int> selected-band-id: -1;       // selected band, -1 = none
    in property <bool> selected-lane-is-ladder: false;
    in property <string> ratio-label: "Ratio: (select two bands)";
    // Set-band-weight (known size) dialog.
    in-out property <bool> weight-dialog-open: false;
    in-out property <string> weight-dialog-value: "";
    in property <string> weight-dialog-unit: "bp";
    // SMTP email settings and recipient prompt.
    in-out property <bool> email-settings-open: false;
    in-out property <string> email-smtp-host: "";
    in-out property <string> email-smtp-port: "587";
    in-out property <string> email-smtp-username: "";
    in-out property <string> email-smtp-password: "";
    in-out property <string> email-from-address: "";
    in-out property <int> email-security-index: 0;
    in-out property <bool> email-to-dialog-open: false;
    in-out property <string> email-to-address: "";
    // Rename-lane dialog.
    in-out property <bool> rename-dialog-open: false;
    in-out property <string> rename-dialog-value: "";
    // Add-lane dialog.
    in-out property <bool> add-lane-dialog-open: false;
    in-out property <string> add-lane-dialog-value: "";
    in-out property <bool> close-confirm-open: false;
    in property <[WarpKnot]> warp-knots;   // control-point handles (overlay)
    in-out property <int> renaming-lane: -1;
    in property <string> status: "Open a .gel.zip, or run `opengel --demo` to load a demo gel.";
    // What the open document is: DNA / RNA / protein. Drives the size unit, the
    // molarity conversion and which ladders the "Use as ladder" dialog offers.
    in property <[string]> gel-type-names;
    in-out property <int> gel-type-index: 0;
    in-out property <int> frame-index: 0;
    // Acquisition channels. The selector is hidden entirely for the ordinary
    // single-channel gel, where a control offering one choice is just noise.
    in property <[string]> channel-names;
    in property <bool> is-multichannel: false;
    in-out property <int> channel-index: 0;
    in property <[MetaRow]> metadata-rows;
    in-out property <float> disp-lo: 0.0;     // contrast window, fractions of [min,max]
    in-out property <float> disp-hi: 1.0;
    in-out property <bool> invert: false;
    in-out property <bool> show-unwarped: false;  // fixed dewarped (rectified) view
    in-out property <bool> optical-flow: false;    // fit warp by optical flow on detect
    in-out property <bool> fit-dialog-use-gelgenie: false;
    in-out property <int> fit-dialog-gelgenie-runtime: 0;
    in property <bool> fit-dialog-gelgenie-available: false;
    in-out property <bool> show-warp: false;  // overlay the fitted NURBS warp grid
    in-out property <bool> normalize-inner-knots: true; // keep v rows evenly spaced while dragging edge knots
    in-out property <bool> show-overexposed: false; // clipped-high pixels in red
    in-out property <float> annotation-alpha: 0.25;  // annotation overlay opacity
    in-out property <string> volume-ul: "10";
    in-out property <float> rotation: 0;      // degrees, live display rotation
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in-out property <float> click-x: -1;      // last click, normalized (viewport)
    in-out property <float> click-y: -1;
    // True when the current document already has detected/edited lanes or bands,
    // so re-detecting would overwrite them (drives the confirm dialog).
    in-out property <bool> has-annotations: false;
    // Confirm-overwrite dialog for re-detection.
    in-out property <bool> confirm-detect-open: false;
    // Fit-model dialog.
    in-out property <bool> fit-dialog-open: false;
    in-out property <bool> fit-dialog-use-band-tilts: true;
    in-out property <string> fit-dialog-extra-edges: "2";
    in-out property <string> fit-dialog-extra-edges-h: "0";
    in-out property <string> fit-dialog-warp-regularization: "0.01";
    in-out property <string> fit-dialog-row-spacing: "10";
    in-out property <string> fit-dialog-flow-smoothness: "8";

    // Recompute-HDR dialog.
    in-out property <bool> hdr-dialog-open: false;
    in-out property <bool> hdr-bias-subtraction: false;
    in-out property <bool> hdr-align: false;
    in-out property <bool> hdr-deghost: false;

    // "Use as ladder" dialog.
    in-out property <int> ladder-dialog-lane: -1;   // -1 = closed
    in-out property <string> dialog-lane-name: "";
    in-out property <int> dialog-ladder-type-index: 0;
    in-out property <int> dialog-ladder-vendor-index: 0;
    in-out property <int> dialog-ladder-index: 0;
    in-out property <string> dialog-volume: "10";
    in-out property <string> dialog-conc: "50";
    // Live tab.
    in property <image> live-preview-image;
    in property <image> live-histogram-image;
    in-out property <bool> live-running: false;
    in-out property <float> live-exposure-slider: 0.5;    // log-mapped exposure
    in property <string> live-exposure-label: "0.10 s";
    in property <string> hdr-min-label: "0.010 s";
    in property <string> hdr-max-label: "1.00 s";
    in property <string> hdr-range-label: "6.6 EV";
    // Exposure controls. Each ComboBox owns its property: two combo boxes
    // two-way bound to one property fight over it and emit `selected` with each
    // other's index, which reads as a user edit.
    in property <[string]> camera-names;
    in-out property <int> camera-index: 0;
    in property <bool> capture-active: false;             // capture in progress
    in property <string> capture-status: "";
    in property <bool> exposure-supported: true;          // camera has manual exposure
    // Which tab is shown. Bound to the TabWidget so `--tab N` can select one.
    in-out property <int> active-tab: 0;

    // Gel Doc EZ tab.
    in property <[string]> gd-instrument-names;
    in-out property <int> gd-instrument-index: 0;
    in property <bool> gd-connected: false;
    in property <bool> gd-simulated: false;
    in property <string> gd-model: "—";
    in property <string> gd-versions: "";
    in property <string> gd-serial: "";
    // Live instrument state.
    in property <string> gd-tray-label: "—";
    in property <bool> gd-tray-present: false;
    in property <bool> gd-door-closed: false;
    in property <bool> gd-busy: false;
    // The lamps are lit (including during a stain-free activation) — the state
    // in which the door must stay shut.
    in property <bool> gd-lamps-on: false;
    in property <[FaultItem]> gd-faults;
    in property <string> gd-undecoded-label: "";
    // Channels: one per light source. The list is the whole acquisition — for
    // each ticked channel, one image.
    in property <[ChannelItem]> gd-channel-items;
    in property <[string]> gd-channel-names;      // the same channels, for a dropdown
    in property <int> gd-channel-index: 0;        // the channel being edited/framed
    // Exposure controls for the channel being edited (see the note above).
    in-out property <int> gd-capture-mode-index: 0;
    in-out property <int> gd-hdr-steps-idx: 1;
    in-out property <int> gd-gel-type-index: 0;
    in property <string> gd-channel-label: "UV";
    // Whether the channel being edited is the tray that is inserted. Imaging on
    // the wrong light source gives a blank gel with nothing obviously wrong.
    in property <bool> gd-channel-ready: false;
    in property <string> gd-channel-hint: "";
    // The tray the simulated bench currently holds, for its own control.
    in-out property <int> gd-sim-tray-index: 0;
    in-out property <string> gd-activation-s: "45";
    in property <bool> gd-activation-applicable: false;
    in-out property <bool> gd-highlight-saturated: true;
    in property <string> gd-last-exposure-label: "";
    // Run.
    in property <bool> gd-can-run: false;
    in property <string> gd-run-blocker: "";
    in property <bool> gd-running: false;
    in property <string> gd-phase-label: "Ready.";
    in property <string> gd-run-progress: "";
    in property <float> gd-activation-progress: 0;
    in property <string> gd-message: "";

    // Trace tab.
    in property <[TracePath]> trace-plots;
    in property <[string]> trace-yticks;
    in property <[string]> trace-xticks;
    in property <[AxisTick]> trace-xticks-top;  // ladder-based bp scale (top axis)
    in property <string> trace-xtoplabel;       // e.g. "Size (bp)"; empty = no ladder
    in property <string> trace-xlabel: "Migration (px)";
    in property <string> trace-ylabel: "Intensity (a.u.)";
    in property <[LaneItem]> lane-items;
    in-out property <int> trace-mode-idx: 0;
    in-out property <float> trace-zoom: 1.0;    // horizontal zoom (1 = fit)

    // --- callbacks out ---
    callback open();
    callback save();
    callback save-as();
    callback file-changed(int);
    callback close-current-file();
    callback open-hdr-dialog();
    callback apply-hdr-dialog();     // recompute the HDR merge with the options
    callback cancel-hdr-dialog();
    callback open-email-settings();
    callback apply-email-settings();
    callback cancel-email-settings();
    callback open-email-to-dialog();
    callback send-email-to();
    callback cancel-email-to();
    callback capture();
    callback analyze();
    callback open-fit-dialog();
    callback apply-fit-dialog();
    callback cancel-fit-dialog();
    callback measure();
    callback frame-changed(int);
    callback channel-changed(int);
    callback display-changed();
    callback hover-moved(float, float);   // normalized hover pos over the gel
    callback press-at(float, float) -> bool; // select annotation; true = draggable
    callback drag-to(float, float);          // drag the selected annotation
    callback release-annotation();           // end drag (re-measure)
    callback compare();
    callback about();
    callback how-to-cite();
    callback rotate(float);
    callback auto-straighten();
    callback add-lane();
    callback add-band();
    callback calibrate();
    // Tree list actions.
    callback lane-toggle(int);            // expand / collapse
    callback lane-set(int);               // (ladder lane) re-apply ladder sizing
    callback lane-menu(int, string);      // "delete" | "unmark"
    callback select-tree(int, int);       // (kind, id): select a lane/band row
    callback delete-selected();           // delete the selected lane or band
    callback open-weight-dialog();        // set the selected band's known size
    callback apply-weight-dialog();
    callback cancel-weight-dialog();
    callback open-rename-dialog();        // rename the selected lane
    callback apply-rename-dialog();
    callback cancel-rename-dialog();
    callback open-add-lane-dialog();      // add a lane (asks for its name)
    callback apply-add-lane-dialog();
    callback cancel-add-lane-dialog();
    callback set-ratio-a();               // ratio band A = selected band
    callback set-ratio-b();               // ratio band B = selected band
    callback lane-renamed(int, string);   // commit an inline rename
    callback band-menu(int, string);      // "delete" for a band
    // Ladder dialog.
    callback gel-type-changed(int);
    callback open-ladder-dialog(int);
    callback ladder-type-changed(int);
    callback ladder-vendor-changed(int);
    callback apply-ladder-dialog();
    callback cancel-ladder-dialog();
    // Live tab.
    callback live-start();
    callback live-stop();
    callback live-capture();               // take this channel's image
    callback live-auto();                  // meter, and set this channel from it
    callback cancel-capture();             // cancel an in-progress capture
    callback live-exposure-changed(float); // exposure slider moved
    callback set-hdr-lower();              // adopt current exposure as HDR min
    callback set-hdr-upper();              // adopt current exposure as HDR max
    callback hdr-steps-changed(int);
    callback capture-mode-changed(int);    // single / HDR, for this channel
    callback camera-selected(int);         // pick a camera from the dropdown
    callback rescan-cameras();             // re-enumerate cameras
    // Gel Doc EZ tab.
    callback gd-rescan();
    callback gd-instrument-selected(int);
    callback gd-connect();
    callback gd-disconnect();
    callback gd-clear-faults();
    callback gd-channel-selected(int);       // edit / frame this channel
    callback gd-channel-toggled(int, bool);  // include it in the run
    callback gd-activation-changed(string);
    callback gd-highlight-saturated-changed(bool);
    callback gd-auto();                      // meter every selected channel
    callback gd-run();
    callback gd-abort();
    // Simulated-enclosure bench controls.
    callback gd-sim-tray(int);
    callback gd-sim-door(bool);
    callback gd-sim-fault(int, bool);
    callback gd-sim-press-button();

    // Trace tab.
    callback toggle-lane(int);
    callback trace-mode-changed(int);
    callback select-all-lanes();
    callback select-none-lanes();
    callback export-trace-pdf();
    callback trace-set-zoom(float);       // slider → absolute zoom
    callback trace-zoom-at(float, float); // scroll: (factor, focus-fraction 0..1)
    callback trace-pan(float);            // drag: pointer dx as a fraction of width
    callback trace-reset-view();
    callback trace-hover(float);          // hover x-fraction 0..1 over plot area

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open…"; activated => { root.open(); } }
            MenuItem { title: "Save"; enabled: root.has-open-file; activated => { root.save(); } }
            MenuItem { title: "Save as…"; enabled: root.has-open-file; activated => { root.save-as(); } }
            MenuItem { title: "Email settings…"; activated => { root.open-email-settings(); } }
            MenuItem { title: "Email data to…"; enabled: root.has-open-file; activated => { root.open-email-to-dialog(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "How to cite"; activated => { root.how-to-cite(); } }
            MenuItem { title: "About OpenGel"; activated => { root.about(); } }
        }
    }

    VerticalLayout {
    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        Text { text: "File:"; vertical-alignment: center; }
        ComboBox {
            model: root.file-names;
            current-index <=> root.file-index;
            horizontal-stretch: 1;
            vertical-stretch: 0;
            enabled: root.has-open-file;
            selected(v) => { root.file-changed(self.current-index); }
        }
        Text { text: "Gel type:"; vertical-alignment: center; }
        ComboBox {
            model: root.gel-type-names;
            current-index <=> root.gel-type-index;
            vertical-stretch: 0;
            width: 110px;
            enabled: root.has-open-file;
            selected(v) => { root.gel-type-changed(self.current-index); }
        }
        Button {
            text: "Close";
            vertical-stretch: 0;
            enabled: root.has-open-file;
            clicked => {
                if (root.active-file-dirty) { root.close-confirm-open = true; }
                else { root.close-current-file(); }
            }
        }
    }
    // Tabs, hand-built rather than a TabWidget: a tab with nothing behind it is
    // greyed out, and Slint's TabWidget cannot disable a tab. Indices are fixed
    // (0 Gel, 1 Trace, 2 Metadata, 3 Capture), so `--tab N` means one thing.
    Rectangle {
      height: 30px;
      background: #f4f4f6;
      Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: #d0d0d4; }
      HorizontalLayout {
        alignment: start;
        // Gel, Trace and Metadata are views *of a document*: with nothing open
        // there is nothing to look at, so they are greyed until there is.
        TabButton {
          label: "Gel"; active: root.active-tab == 0; enabled: root.has-open-file;
          clicked => { root.active-tab = 0; }
        }
        TabButton {
          label: "Trace"; active: root.active-tab == 1; enabled: root.has-open-file;
          clicked => { root.active-tab = 1; }
        }
        TabButton {
          label: "Metadata"; active: root.active-tab == 2; enabled: root.has-open-file;
          clicked => { root.active-tab = 2; }
        }
        TabButton {
          label: "Capture"; active: root.active-tab == 3;
          clicked => { root.active-tab = 3; }
        }
      }
    }
    VerticalLayout {
      vertical-stretch: 1;
      if root.active-tab == 0: GelTab {
        press-at(a0, a1) => { return root.press-at(a0, a1); }
        annotation-alpha <=> root.annotation-alpha;
        channel-index <=> root.channel-index;
        channel-names : root.channel-names;
        click-x <=> root.click-x;
        click-y <=> root.click-y;
        confirm-detect-open <=> root.confirm-detect-open;
        disp-hi <=> root.disp-hi;
        disp-lo <=> root.disp-lo;
        frame-index <=> root.frame-index;
        frame-names : root.frame-names;
        gel-image : root.gel-image;
        has-annotations <=> root.has-annotations;
        has-open-file : root.has-open-file;
        histogram-image : root.histogram-image;
        invert <=> root.invert;
        is-multichannel : root.is-multichannel;
        normalize-inner-knots <=> root.normalize-inner-knots;
        pan-x <=> root.pan-x;
        pan-y <=> root.pan-y;
        ratio-label : root.ratio-label;
        renaming-lane <=> root.renaming-lane;
        rotation <=> root.rotation;
        selected-band-id : root.selected-band-id;
        selected-lane-id : root.selected-lane-id;
        selected-lane-is-ladder : root.selected-lane-is-ladder;
        show-overexposed <=> root.show-overexposed;
        show-unwarped <=> root.show-unwarped;
        show-warp <=> root.show-warp;
        tree-rows : root.tree-rows;
        warp-knots : root.warp-knots;
        zoom <=> root.zoom;
        add-band => { root.add-band(); }
        auto-straighten => { root.auto-straighten(); }
        channel-changed(a0) => { root.channel-changed(a0); }
        delete-selected => { root.delete-selected(); }
        display-changed => { root.display-changed(); }
        drag-to(a0, a1) => { root.drag-to(a0, a1); }
        frame-changed(a0) => { root.frame-changed(a0); }
        hover-moved(a0, a1) => { root.hover-moved(a0, a1); }
        lane-menu(a0, a1) => { root.lane-menu(a0, a1); }
        lane-renamed(a0, a1) => { root.lane-renamed(a0, a1); }
        lane-toggle(a0) => { root.lane-toggle(a0); }
        open-add-lane-dialog => { root.open-add-lane-dialog(); }
        open-fit-dialog => { root.open-fit-dialog(); }
        open-hdr-dialog => { root.open-hdr-dialog(); }
        open-ladder-dialog(a0) => { root.open-ladder-dialog(a0); }
        open-rename-dialog => { root.open-rename-dialog(); }
        open-weight-dialog => { root.open-weight-dialog(); }
        release-annotation => { root.release-annotation(); }
        rotate(a0) => { root.rotate(a0); }
        select-tree(a0, a1) => { root.select-tree(a0, a1); }
        set-ratio-a => { root.set-ratio-a(); }
        set-ratio-b => { root.set-ratio-b(); }
      }

      if root.active-tab == 1: TraceTab {
        has-open-file : root.has-open-file;
        lane-items : root.lane-items;
        trace-mode-idx <=> root.trace-mode-idx;
        trace-plots : root.trace-plots;
        trace-xlabel : root.trace-xlabel;
        trace-xticks : root.trace-xticks;
        trace-xticks-top : root.trace-xticks-top;
        trace-xtoplabel : root.trace-xtoplabel;
        trace-ylabel : root.trace-ylabel;
        trace-yticks : root.trace-yticks;
        trace-zoom <=> root.trace-zoom;
        export-trace-pdf => { root.export-trace-pdf(); }
        select-all-lanes => { root.select-all-lanes(); }
        select-none-lanes => { root.select-none-lanes(); }
        toggle-lane(a0) => { root.toggle-lane(a0); }
        trace-hover(a0) => { root.trace-hover(a0); }
        trace-mode-changed(a0) => { root.trace-mode-changed(a0); }
        trace-pan(a0) => { root.trace-pan(a0); }
        trace-reset-view => { root.trace-reset-view(); }
        trace-set-zoom(a0) => { root.trace-set-zoom(a0); }
        trace-zoom-at(a0, a1) => { root.trace-zoom-at(a0, a1); }
      }

      // ---- Live ------------------------------------------------------------
      // A bare camera, framing one channel. The channel is a light source, so
      // the exposure settings shown here are that channel's — the same ones the
      // Gel Doc EZ tab runs.
      // ---- Metadata --------------------------------------------------------
      // What the instrument recorded about how the image was taken, shown as
      // plain name/value rows. Nothing here is interpreted: instruments
      // disagree about what they report, and the honest thing is to display
      // whatever the file carried rather than the fields we anticipated.
      if root.active-tab == 2: MetadataTab {
        has-open-file : root.has-open-file;
        metadata-rows : root.metadata-rows;
      }
      // ---- Capture ---------------------------------------------------------
      // One tab for taking pictures, whatever is attached. With a plain camera
      // it is a viewfinder and a Capture button: one channel, no lights to
      // manage. With an imaging enclosure the same tab grows the things only an
      // enclosure has — a channel per light source, the door and tray
      // interlocks, latched faults, and a run that walks the channels. The
      // hardware decides which; there is nothing to switch between by hand.
      if root.active-tab == 3: CaptureTab {
        camera-index <=> root.camera-index;
        camera-names : root.camera-names;
        capture-active : root.capture-active;
        exposure-supported : root.exposure-supported;
        gd-activation-applicable : root.gd-activation-applicable;
        gd-activation-progress : root.gd-activation-progress;
        gd-activation-s <=> root.gd-activation-s;
        gd-busy : root.gd-busy;
        gd-can-run : root.gd-can-run;
        gd-capture-mode-index <=> root.gd-capture-mode-index;
        gd-channel-hint : root.gd-channel-hint;
        gd-channel-index : root.gd-channel-index;
        gd-channel-items : root.gd-channel-items;
        gd-channel-ready : root.gd-channel-ready;
        gd-connected : root.gd-connected;
        gd-door-closed : root.gd-door-closed;
        gd-faults : root.gd-faults;
        gd-gel-type-index <=> root.gd-gel-type-index;
        gd-hdr-steps-idx <=> root.gd-hdr-steps-idx;
        gd-highlight-saturated <=> root.gd-highlight-saturated;
        gd-instrument-index <=> root.gd-instrument-index;
        gd-instrument-names : root.gd-instrument-names;
        gd-lamps-on : root.gd-lamps-on;
        gd-message : root.gd-message;
        gd-model : root.gd-model;
        gd-phase-label : root.gd-phase-label;
        gd-run-blocker : root.gd-run-blocker;
        gd-run-progress : root.gd-run-progress;
        gd-running : root.gd-running;
        gd-serial : root.gd-serial;
        gd-sim-tray-index <=> root.gd-sim-tray-index;
        gd-simulated : root.gd-simulated;
        gd-tray-label : root.gd-tray-label;
        gd-tray-present : root.gd-tray-present;
        gd-versions : root.gd-versions;
        gel-type-names : root.gel-type-names;
        hdr-max-label : root.hdr-max-label;
        hdr-min-label : root.hdr-min-label;
        hdr-range-label : root.hdr-range-label;
        live-exposure-label : root.live-exposure-label;
        live-exposure-slider <=> root.live-exposure-slider;
        live-histogram-image : root.live-histogram-image;
        live-preview-image : root.live-preview-image;
        live-running <=> root.live-running;
        camera-selected(a0) => { root.camera-selected(a0); }
        capture-mode-changed(a0) => { root.capture-mode-changed(a0); }
        gd-abort => { root.gd-abort(); }
        gd-activation-changed(a0) => { root.gd-activation-changed(a0); }
        gd-auto => { root.gd-auto(); }
        gd-channel-selected(a0) => { root.gd-channel-selected(a0); }
        gd-channel-toggled(a0, a1) => { root.gd-channel-toggled(a0, a1); }
        gd-clear-faults => { root.gd-clear-faults(); }
        gd-connect => { root.gd-connect(); }
        gd-disconnect => { root.gd-disconnect(); }
        gd-highlight-saturated-changed(a0) => { root.gd-highlight-saturated-changed(a0); }
        gd-instrument-selected(a0) => { root.gd-instrument-selected(a0); }
        gd-run => { root.gd-run(); }
        gd-sim-door(a0) => { root.gd-sim-door(a0); }
        gd-sim-fault(a0, a1) => { root.gd-sim-fault(a0, a1); }
        gd-sim-press-button => { root.gd-sim-press-button(); }
        gd-sim-tray(a0) => { root.gd-sim-tray(a0); }
        gel-type-changed(a0) => { root.gel-type-changed(a0); }
        hdr-steps-changed(a0) => { root.hdr-steps-changed(a0); }
        live-auto => { root.live-auto(); }
        live-capture => { root.live-capture(); }
        live-exposure-changed(a0) => { root.live-exposure-changed(a0); }
        live-start => { root.live-start(); }
        live-stop => { root.live-stop(); }
        rescan-cameras => { root.rescan-cameras(); }
        set-hdr-lower => { root.set-hdr-lower(); }
        set-hdr-upper => { root.set-hdr-upper(); }
      }
    }

    // status bar (laid out below the tabs so it never overlaps their content)
    Rectangle {
        height: 24px;
        width: 100%;
        background: #f0f0f2;
        Rectangle { y: 0; height: 1px; width: 100%; background: #d0d0d4; } // top divider
        Text {
            text: root.status;
            color: #333333;
            vertical-alignment: center;
            x: 8px;
        }
    }
    }

    // ---- Close dirty document confirmation ----
    if root.close-confirm-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Close unsaved file?"; font-size: 15px; font-weight: 700; }
                Text {
                    text: "This file has unsaved changes. Closing it will discard them.";
                    color: #555555;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.close-confirm-open = false; } }
                    Button {
                        text: "Discard";
                        clicked => {
                            root.close-confirm-open = false;
                            root.close-current-file();
                        }
                    }
                }
            }
        }
    }

    // ---- Capture progress dialog (camera I/O runs off the UI thread) ----
    if root.capture-active: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }  // swallow clicks behind the dialog
        Rectangle {
            width: 340px;
            height: 150px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { text: "Capturing…"; font-size: 15px; font-weight: 700; }
                Text { text: root.capture-status; color: #555; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    Button { text: "Cancel"; clicked => { root.cancel-capture(); } }
                }
            }
        }
    }

    // ---- Recompute-HDR modal dialog ----
    if root.hdr-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Recompute HDR"; font-size: 15px; font-weight: 700; }
                Text {
                    text: "Re-merge the exposure bracket into the working image. All options are off by default (a plain linear hat-weighted merge).";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                CheckBox {
                    text: "Dark-frame / bias subtraction";
                    checked <=> root.hdr-bias-subtraction;
                }
                Text {
                    text: "Estimate each frame's black level and subtract it before merging, so faint bands aren't lifted by the sensor's dark offset.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                CheckBox {
                    text: "Alignment (de-shift)";
                    checked <=> root.hdr-align;
                }
                Text {
                    text: "Register each frame to the best-exposed one by FFT phase correlation (corrects small translations between exposures).";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                CheckBox {
                    text: "De-ghosting";
                    checked <=> root.hdr-deghost;
                }
                Text {
                    text: "Reject, per pixel, exposure samples that disagree with the across-exposure median (something that moved between frames).";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-hdr-dialog(); } }
                    Button {
                        text: "Recompute";
                        primary: true;
                        clicked => { root.apply-hdr-dialog(); }
                    }
                }
            }
        }
    }

    // ---- "Use as ladder" modal dialog ----
    if root.confirm-detect-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Re-detect lanes & bands?"; font-size: 15px; font-weight: 700; }
                Text {
                    text: "This overwrites the current lanes, bands and any manual edits.";
                    color: #555;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.confirm-detect-open = false; } }
                    Button {
                        text: "Overwrite";
                        primary: true;
                        clicked => {
                            root.confirm-detect-open = false;
                            root.open-fit-dialog();
                        }
                    }
                }
            }
        }
    }

    // ---- Fit model modal dialog ----
    if root.rename-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 340px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Rename lane"; font-size: 15px; font-weight: 700; }
                LineEdit {
                    text <=> root.rename-dialog-value;
                    accepted(t) => { root.apply-rename-dialog(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-rename-dialog(); } }
                    Button { text: "OK"; primary: true; clicked => { root.apply-rename-dialog(); } }
                }
            }
        }
    }

    if root.add-lane-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 340px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Add lane"; font-size: 15px; font-weight: 700; }
                add-lane-edit := LineEdit {
                    text <=> root.add-lane-dialog-value;
                    accepted(t) => { root.apply-add-lane-dialog(); }
                    // Pre-select the default name so typing replaces it.
                    init => { self.focus(); self.select-all(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-add-lane-dialog(); } }
                    Button { text: "OK"; primary: true; clicked => { root.apply-add-lane-dialog(); } }
                }
            }
        }
    }

    if root.weight-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 340px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Set band weight"; font-size: 15px; font-weight: 700; }
                HorizontalBox {
                    Text { text: "Size (" + root.weight-dialog-unit + "):"; vertical-alignment: center; width: 110px; }
                    LineEdit { text <=> root.weight-dialog-value; horizontal-stretch: 1; }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-weight-dialog(); } }
                    Button { text: "OK"; primary: true; clicked => { root.apply-weight-dialog(); } }
                }
            }
        }
    }

    if root.email-settings-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 360px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Email settings"; font-size: 15px; font-weight: 700; }
                HorizontalBox {
                    Text { text: "SMTP host:"; vertical-alignment: center; width: 130px; }
                    LineEdit { text <=> root.email-smtp-host; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "SMTP port:"; vertical-alignment: center; width: 130px; }
                    LineEdit { text <=> root.email-smtp-port; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "Username:"; vertical-alignment: center; width: 130px; }
                    LineEdit { text <=> root.email-smtp-username; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "Password:"; vertical-alignment: center; width: 130px; }
                    LineEdit { text <=> root.email-smtp-password; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "From address:"; vertical-alignment: center; width: 130px; }
                    LineEdit { text <=> root.email-from-address; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "Security:"; vertical-alignment: center; width: 130px; }
                    ComboBox {
                        model: ["STARTTLS", "TLS", "None"];
                        current-index <=> root.email-security-index;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-email-settings(); } }
                    Button { text: "Save"; primary: true; clicked => { root.apply-email-settings(); } }
                }
            }
        }
    }

    if root.email-to-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 360px;
            height: 170px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Email data to"; font-size: 15px; font-weight: 700; }
                LineEdit {
                    text <=> root.email-to-address;
                    accepted(t) => { root.send-email-to(); }
                    init => { self.focus(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-email-to(); } }
                    Button { text: "Send"; primary: true; clicked => { root.send-email-to(); } }
                }
            }
        }
    }

    if root.fit-dialog-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: 710px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: "Fit Model"; font-size: 15px; font-weight: 700; }

                CheckBox {
                    text: "Use GelGenie ML model";
                    checked <=> root.fit-dialog-use-gelgenie;
                    enabled: root.fit-dialog-gelgenie-available;
                }
                HorizontalBox {
                    Text { text: "GelGenie runtime:"; vertical-alignment: center; width: 230px; }
                    ComboBox {
                        model: ["CPU", "WGPU"];
                        current-index <=> root.fit-dialog-gelgenie-runtime;
                        enabled: root.fit-dialog-use-gelgenie && root.fit-dialog-gelgenie-available;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.fit-dialog-gelgenie-available ? "GelGenie segments bands with the bundled Burn model, then reuses OpenGel lane, ladder, and sizing analysis." : "GelGenie model asset not found. Set OPENGEL_GELGENIE_MODEL or install assets/models/gelgenie_unet_1024.bpk.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                CheckBox {
                    text: "Use band tilts";
                    checked <=> root.fit-dialog-use-band-tilts;
                }
                Text {
                    text: "Shape the warp from each detected band's measured tilt. Uncheck to use optical-flow registration instead (helps where bands are faint or absent).";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                HorizontalBox {
                    Text { text: "Extra migration edges (vertical):"; vertical-alignment: center; width: 230px; }
                    LineEdit { text <=> root.fit-dialog-extra-edges; horizontal-stretch: 1; }
                }
                Text {
                    text: "Extra control rows along the migration (top→bottom) axis. Bands are always pinned to their detected migration; these rows add up/down bending freedom between them. 0 = minimal.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                HorizontalBox {
                    Text { text: "Extra cross-lane edges (horizontal):"; vertical-alignment: center; width: 230px; }
                    LineEdit { text <=> root.fit-dialog-extra-edges-h; horizontal-stretch: 1; }
                }
                Text {
                    text: "Extra control columns across the gel, beyond the edges and one column per lane. Adds side-to-side bending freedom between lanes. 0 = one column per lane only.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                HorizontalBox {
                    Text { text: "Warp regularization:"; vertical-alignment: center; width: 230px; }
                    LineEdit { text <=> root.fit-dialog-warp-regularization; horizontal-stretch: 1; }
                }
                Text {
                    text: "How strongly the fit is pulled back toward a flat grid. Higher = stiffer/smoother (resists bending to noise); lower = follows the bands more closely.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                HorizontalBox {
                    Text { text: "Row spacing weight:"; vertical-alignment: center; width: 230px; }
                    LineEdit { text <=> root.fit-dialog-row-spacing; horizontal-stretch: 1; }
                }
                Text {
                    text: "Keeps adjacent migration rows evenly spaced so unconstrained rows don't fold together. Higher = more uniform spacing.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                HorizontalBox {
                    Text {
                        text: "Flow smoothness:";
                        vertical-alignment: center;
                        width: 230px;
                        color: root.fit-dialog-use-band-tilts ? #000000 : #aaaaaa;
                    }
                    LineEdit {
                        text <=> root.fit-dialog-flow-smoothness;
                        horizontal-stretch: 1;
                        enabled: root.fit-dialog-use-band-tilts;
                    }
                }
                Text {
                    text: "When using band tilts only: smoothness of the flow field. Higher = stiffer, more interpolation between confident strips.";
                    color: #777777; font-size: 11px; wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-fit-dialog(); } }
                    Button {
                        text: "Detect";
                        primary: true;
                        clicked => { root.apply-fit-dialog(); }
                    }
                }
            }
        }
    }

    if root.ladder-dialog-lane >= 0: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000088;
        // Swallow clicks behind the dialog.
        TouchArea { }
        Rectangle {
            width: 430px;
            height: 415px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cccccc;
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text { text: "Use “" + root.dialog-lane-name + "” as ladder"; font-size: 15px; font-weight: 700; }
                HorizontalBox {
                    Text { text: "Type:"; vertical-alignment: center; width: 120px; }
                    ComboBox {
                        model: root.gel-type-names;
                        current-index <=> root.dialog-ladder-type-index;
                        horizontal-stretch: 1;
                        selected(value) => { root.ladder-type-changed(root.dialog-ladder-type-index); }
                    }
                }
                HorizontalBox {
                    Text { text: "Company:"; vertical-alignment: center; width: 120px; }
                    ComboBox {
                        model: root.ladder-vendor-names;
                        current-index <=> root.dialog-ladder-vendor-index;
                        horizontal-stretch: 1;
                        selected(value) => { root.ladder-vendor-changed(root.dialog-ladder-vendor-index); }
                    }
                }
                HorizontalBox {
                    Text { text: "Ladder:"; vertical-alignment: center; width: 120px; }
                    ComboBox {
                        model: root.ladder-names;
                        current-index <=> root.dialog-ladder-index;
                        horizontal-stretch: 1;
                    }
                }
                HorizontalBox {
                    Text { text: "Volume (µL):"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.dialog-volume; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    Text { text: "Concentration (ng/µL):"; vertical-alignment: center; width: 120px; }
                    LineEdit { text <=> root.dialog-conc; horizontal-stretch: 1; }
                }
                Text { text: "Load = volume × concentration (ng)."; color: #888; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button { text: "Cancel"; clicked => { root.cancel-ladder-dialog(); } }
                    Button { text: "OK"; primary: true; clicked => { root.apply-ladder-dialog(); } }
                }
            }
        }
    }
}
