import { TreeRow, WarpKnot } from "common.slint";
import { Button, ComboBox, CheckBox, Slider, GroupBox, ScrollView, LineEdit, HorizontalBox, VerticalBox, ListView } from "std-widgets.slint";

export component GelTab inherits HorizontalBox {
    in-out property <float> annotation-alpha: 0.25;
    in-out property <int> channel-index: 0;
    in property <[string]> channel-names;
    in-out property <float> click-x: -1;
    in-out property <float> click-y: -1;
    in-out property <bool> confirm-detect-open: false;
    in-out property <float> disp-hi: 1.0;
    in-out property <float> disp-lo: 0.0;
    in-out property <int> frame-index: 0;
    in property <[string]> frame-names;
    in property <image> gel-image;
    in-out property <bool> has-annotations: false;
    in property <bool> has-open-file: false;
    in property <image> histogram-image;
    in-out property <bool> invert: false;
    in property <bool> is-multichannel: false;
    in-out property <bool> normalize-inner-knots: true;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <string> ratio-label: "Ratio: (select two bands)";
    in-out property <int> renaming-lane: -1;
    in-out property <float> rotation: 0;
    in property <int> selected-band-id: -1;
    in property <int> selected-lane-id: -1;
    in property <bool> selected-lane-is-ladder: false;
    in-out property <bool> show-overexposed: false;
    in-out property <bool> show-unwarped: false;
    in-out property <bool> show-warp: false;
    in property <[TreeRow]> tree-rows;
    in property <[WarpKnot]> warp-knots;
    in-out property <float> zoom: 1.0;
    callback add-band();
    callback auto-straighten();
    callback channel-changed(int);
    callback delete-selected();
    callback display-changed();
    callback drag-to(float, float);
    callback frame-changed(int);
    callback hover-moved(float, float);
    callback lane-menu(int, string);
    callback lane-renamed(int, string);
    callback lane-toggle(int);
    callback open-add-lane-dialog();
    callback open-fit-dialog();
    callback open-hdr-dialog();
    callback open-ladder-dialog(int);
    callback open-rename-dialog();
    callback open-weight-dialog();
    callback release-annotation();
    callback rotate(float);
    callback select-tree(int, int);
    callback set-ratio-a();
    callback set-ratio-b();
    callback press-at(float, float) -> bool;

    // Reset view (fit).
    function fit-view() {
        root.zoom = 1.0;
        root.pan-x = 0px;
        root.pan-y = 0px;
    }

    // Move one edge of the contrast window (which: 1 = black/low, 2 = white/high)
    // to fraction `f`, keeping a minimum gap so the image never collapses.
    function apply-window(which: int, f: float) {
        if (which == 1) {
            root.disp-lo = Math.max(0, Math.min(f, root.disp-hi - 0.02));
        } else {
            root.disp-hi = Math.min(1, Math.max(f, root.disp-lo + 0.02));
        }
        root.display-changed();
    }

    // ---- left: image + controls ----
    VerticalBox {
        // View controls: frame, zoom, rotate. Kept compact (no vertical
        // padding) so the toolbar doesn't steal height from the gel view.
        HorizontalLayout {
            spacing: 6px;
            padding: 0px;
            // Channel first: it selects which acquisition you are looking
            // at, and the frame selector below picks an exposure within it.
            if root.is-multichannel: Text { text: "Channel:"; vertical-alignment: center; }
            if root.is-multichannel: ComboBox {
                model: root.channel-names;
                current-index <=> root.channel-index;
                width: 175px;
                vertical-stretch: 0;
                enabled: root.has-open-file;
                selected(v) => { root.channel-changed(self.current-index); }
            }
            Text { text: "Image:"; vertical-alignment: center; }
            ComboBox {
                model: root.frame-names;
                current-index <=> root.frame-index;
                width: 145px;
                vertical-stretch: 0;
                enabled: root.has-open-file;
                selected(v) => { root.frame-changed(self.current-index); }
            }
            Button {
                text: "Recompute HDR…";
                enabled: root.has-open-file;
                vertical-stretch: 0;
                clicked => { root.open-hdr-dialog(); }
            }
            Text { text: "Z:"; vertical-alignment: center; }
            Slider {
                minimum: 0.2; maximum: 8.0; value <=> root.zoom;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                enabled: root.has-open-file;
            }
            Text { text: "R:"; vertical-alignment: center; }
            Slider {
                minimum: -180; maximum: 180; value <=> root.rotation;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                enabled: root.has-open-file;
                changed(v) => { root.rotate(v); }
            }
            Button { icon: @image-url("icon_fit.svg"); colorize-icon: true; vertical-stretch: 0; enabled: root.has-open-file; clicked => { root.fit-view(); } }
            Button { icon: @image-url("icon_auto.svg"); colorize-icon: true; vertical-stretch: 0; enabled: root.has-open-file; clicked => { root.auto-straighten(); } }
        }

        // Zoom / pan / rotate viewport.
        vp := Rectangle {
            background: root.invert ? #ffffff : #1c1c1c;
            border-width: 1px;
            border-color: #444;
            vertical-stretch: 1;
            clip: true;

            // Zoom + pan container; the gel image (with overlays composited
            // in) rotates live via the Image's rotation-angle.
            // "Show unwarped" renders the rectified (straightened) gel, which
            // must be shown flat — ignoring zoom, pan and rotation.
            Rectangle {
                width: root.show-unwarped ? parent.width : parent.width * root.zoom;
                height: root.show-unwarped ? parent.height : parent.height * root.zoom;
                x: (parent.width - self.width) / 2 + (root.show-unwarped ? 0px : root.pan-x);
                y: (parent.height - self.height) / 2 + (root.show-unwarped ? 0px : root.pan-y);

                Image {
                    source: root.gel-image;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                    transform-rotation: root.show-unwarped ? 0deg : root.rotation * 1deg;
                }
            }

            // Pointer layer (topmost) for pan / zoom / click / hover.
            ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.has-open-file;
                property <length> start-pan-x;
                property <length> start-pan-y;
                property <bool> drag-mode;   // dragging an annotation (vs panning)
                // --- map viewport pointer coords to image-normalized [0,1],
                // accounting for the zoom container + contain letterboxing + pan.
                property <length> cw: vp.width * root.zoom;   // container size
                property <length> ch: vp.height * root.zoom;
                property <float> ia: root.gel-image.width * 1.0 / max(1, root.gel-image.height); // image aspect
                property <float> ca: vp.width / vp.height;    // container aspect (zoom cancels)
                property <length> dw: self.ia > self.ca ? self.cw : self.ch * self.ia; // displayed img size
                property <length> dh: self.ia > self.ca ? self.cw / self.ia : self.ch;
                property <length> ix0: (vp.width - self.cw) / 2 + root.pan-x + (self.cw - self.dw) / 2;
                property <length> iy0: (vp.height - self.ch) / 2 + root.pan-y + (self.ch - self.dh) / 2;
                property <float> nx: (self.mouse-x - self.ix0) / max(1px, self.dw);
                property <float> ny: (self.mouse-y - self.iy0) / max(1px, self.dh);
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.start-pan-x = root.pan-x;
                        self.start-pan-y = root.pan-y;
                        // Try to grab an annotation; if none, this becomes a pan.
                        self.drag-mode = root.press-at(self.nx, self.ny);
                    }
                    if (e.kind == PointerEventKind.up) {
                        if (self.drag-mode) { root.release-annotation(); }
                        self.drag-mode = false;
                    }
                }
                moved => {
                    if (self.drag-mode) {
                        root.drag-to(self.nx, self.ny);
                    } else {
                        root.pan-x = self.start-pan-x + (self.mouse-x - self.pressed-x);
                        root.pan-y = self.start-pan-y + (self.mouse-y - self.pressed-y);
                    }
                }
                // Continuous hover → alignment line following the warp.
                changed nx => { root.hover-moved(self.nx, self.ny); }
                changed ny => { root.hover-moved(self.nx, self.ny); }
                scroll-event(e) => {
                    root.zoom = max(0.2, min(8.0, root.zoom * (1.0 + (e.delta-y / 1px) / 400)));
                    return EventResult.accept;
                }
                clicked => {
                    root.click-x = self.nx;
                    root.click-y = self.ny;
                }
            }

            // Warp control-point handles, drawn as a separate overlay (not
            // baked into the gel image) so knots at/beyond the image edge stay
            // visible. Positioned in the displayed-image frame via `ta`'s
            // letterbox mapping. These have no TouchArea, so pointer events
            // fall through to `ta`, which hit-tests knots in image coords.
            if root.show-warp: Rectangle {
                // Rotate each knot about the displayed-image center by the same
                // angle as the gel image, so the knots track it under rotation
                // (they already track zoom/pan via ta's letterbox mapping).
                property <angle> ang: root.rotation * 1deg;
                for knot in root.warp-knots: Rectangle {
                    property <length> dx: (knot.nx - 0.5) * ta.dw;
                    property <length> dy: (knot.ny - 0.5) * ta.dh;
                    width: knot.active ? 13px : 11px;
                    height: self.width;
                    x: ta.ix0 + ta.dw / 2 + (Math.cos(parent.ang) * self.dx - Math.sin(parent.ang) * self.dy) - self.width / 2;
                    y: ta.iy0 + ta.dh / 2 + (Math.sin(parent.ang) * self.dx + Math.cos(parent.ang) * self.dy) - self.height / 2;
                    background: knot.active ? #ff9600 : #00d2ff;
                    border-width: 1px;
                    border-color: #141414;
                }
            }
        }

        // Contrast / brightness: drag the black & white edges directly on
        // the histogram.
        HorizontalBox {
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                hist := Rectangle {
                    vertical-stretch: 1;
                    min-height: 66px;
                    border-width: 1px;
                    border-color: #cccccc;
                    clip: true;  // keep edges/knobs from poking outside the box
                    Image {
                        source: root.histogram-image;
                        width: 100%;
                        height: 100%;
                        image-fit: fill;
                    }
                    // Black (low) edge line + knob (knob clamped fully inside).
                    Rectangle { x: root.disp-lo * parent.width - 1px; width: 2px; height: 100%; background: #2277ff; }
                    Rectangle {
                        x: Math.max(0px, Math.min(parent.width - 12px, root.disp-lo * parent.width - 6px));
                        y: parent.height - 10px;
                        width: 12px; height: 10px; background: #2277ff; border-radius: 2px;
                    }
                    // White (high) edge line + knob.
                    Rectangle { x: root.disp-hi * parent.width - 1px; width: 2px; height: 100%; background: #114499; }
                    Rectangle {
                        x: Math.max(0px, Math.min(parent.width - 12px, root.disp-hi * parent.width - 6px));
                        y: 0px;
                        width: 12px; height: 10px; background: #114499; border-radius: 2px;
                    }
                    hist-ta := TouchArea {
                        enabled: root.has-open-file;
                        property <int> active: 1;
                        property <float> frac: Math.max(0, Math.min(1, self.mouse-x / self.width));
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.active = (Math.abs(self.frac - root.disp-lo)
                                               <= Math.abs(self.frac - root.disp-hi)) ? 1 : 2;
                                root.apply-window(self.active, self.frac);
                            }
                        }
                        moved => { root.apply-window(self.active, self.frac); }
                    }
                }
                Text {
                    text: "Contrast — drag the black / white edges on the histogram";
                    color: #999;
                    font-size: 11px;
                }
            }
            VerticalLayout {
                spacing: 4px;
                CheckBox {
                    text: "Invert colors";
                    checked <=> root.invert;
                    enabled: root.has-open-file;
                    toggled => { root.display-changed(); }
                }
                CheckBox {
                    text: "Show unwarped";
                    checked <=> root.show-unwarped;
                    enabled: root.has-open-file;
                    toggled => { root.display-changed(); }
                }
                CheckBox {
                    text: "Show warp model";
                    checked <=> root.show-warp;
                    enabled: root.has-open-file;
                    toggled => { root.display-changed(); }
                }
                CheckBox {
                    text: "Normalize inner knots";
                    checked <=> root.normalize-inner-knots;
                    enabled: root.has-open-file;
                    toggled => { root.display-changed(); }
                }
                CheckBox {
                    text: "Show overexposed (red)";
                    checked <=> root.show-overexposed;
                    enabled: root.has-open-file;
                    toggled => { root.display-changed(); }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Annotations:"; vertical-alignment: center; font-size: 11px; }
                    Slider {
                        minimum: 0.0; maximum: 1.0; value <=> root.annotation-alpha;
                        horizontal-stretch: 1;
                        enabled: root.has-open-file;
                        changed(v) => { root.display-changed(); }
                    }
                }
            }
        }
    }

    // ---- right: controls + tree (tree expands to fill) ----
    VerticalLayout {
        width: 380px;
        padding: 8px;
        spacing: 8px;
            // Column header.
            Rectangle {
                height: 20px;
                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 4px;
                    Text { text: "Name"; horizontal-stretch: 1; color: #888; font-size: 11px; vertical-alignment: center; }
                    Text { text: "Size"; width: 48px; color: #888; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    Text { text: "ng"; width: 36px; color: #888; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    Text { text: "nmol"; width: 44px; color: #888; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    for row in root.tree-rows: Rectangle {
                        height: 28px;
                        background: (row.kind == 0 && row.lane-id == root.selected-lane-id)
                                 || (row.kind == 1 && row.band-id == root.selected-band-id)
                            ? #dbeafe : (row.kind == 0 ? #f4f4f6 : transparent);
                        // Row-click selects it (so the buttons below act on it).
                        // Sits under the content; the expander's TouchArea wins locally.
                        TouchArea {
                            clicked => { root.select-tree(row.kind, row.kind == 0 ? row.lane-id : row.band-id); }
                        }
                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                if row.kind == 0: Rectangle {
                                    width: 18px;
                                    TouchArea {
                                        clicked => { root.lane-toggle(row.lane-id); }
                                        Text {
                                            text: row.expanded ? "▾" : "▸";
                                            color: #666;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                                if row.kind == 1: Rectangle { width: 26px; }
                                if row.kind == 0 && row.lane-id == root.renaming-lane: LineEdit {
                                    text: row.name;
                                    horizontal-stretch: 1;
                                    accepted(t) => { root.lane-renamed(row.lane-id, t); root.renaming-lane = -1; }
                                }
                                if !(row.kind == 0 && row.lane-id == root.renaming-lane): Text {
                                    text: row.name;
                                    color: row.kind == 0 ? (row.is-ladder ? #9a6b00 : #222) : #444;
                                    font-size: row.kind == 0 ? 13px : 12px;
                                    font-weight: row.kind == 0 ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            Text { text: row.size; width: 48px; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; overflow: elide; }
                            Text { text: row.ng; width: 36px; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; overflow: elide; }
                            Text { text: row.nmol; width: 44px; horizontal-alignment: right; vertical-alignment: center; font-size: 12px; overflow: elide; }
                        }
                    }
                }
            }
            // Actions on the selected row (click a lane/band above or on the
            // gel), in two right-aligned rows.
            HorizontalLayout {
                spacing: 6px;
                Button { text: "Add lane"; horizontal-stretch: 1; enabled: root.has-open-file; clicked => { root.open-add-lane-dialog(); } }
                Button { text: "Add band"; horizontal-stretch: 1; enabled: root.has-open-file; clicked => { root.add-band(); } }
                Button {
                    text: "Delete";
                    horizontal-stretch: 1;
                    enabled: root.selected-lane-id >= 0 || root.selected-band-id >= 0;
                    clicked => { root.delete-selected(); }
                }
                Button {
                    text: "Rename";
                    horizontal-stretch: 1;
                    enabled: root.selected-lane-id >= 0;
                    clicked => { root.open-rename-dialog(); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: "Set weight…";
                    horizontal-stretch: 1;
                    enabled: root.selected-band-id >= 0 && root.selected-lane-is-ladder;
                    clicked => { root.open-weight-dialog(); }
                }
                Button {
                    text: root.selected-lane-is-ladder ? "Edit ladder…" : "Use as ladder…";
                    horizontal-stretch: 1;
                    enabled: root.selected-lane-id >= 0;
                    clicked => { root.open-ladder-dialog(root.selected-lane-id); }
                }
                Button {
                    text: "Unmark ladder";
                    horizontal-stretch: 1;
                    enabled: root.selected-lane-is-ladder;
                    clicked => { root.lane-menu(root.selected-lane-id, "unmark"); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                // Detect: red, bottom-right. Confirms before overwriting.
                Rectangle {
                    horizontal-stretch: 1;
                    height: 30px;
                    border-radius: 5px;
                    background: dt.has-hover ? #c0392b : #e74c3c;
                    dt := TouchArea {
                    clicked => {
                        if (root.has-open-file) {
                            if (root.has-annotations) { root.confirm-detect-open = true; }
                            else { root.open-fit-dialog(); }
                        }
                    }
                    }
                    Text { text: "Detect bands"; color: white; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            // Density ratio: pick two bands with Set A / Set B.
            HorizontalLayout {
                spacing: 6px;
                Text { text: root.ratio-label; color: #333333; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Button { text: "Set A"; enabled: root.selected-band-id >= 0; clicked => { root.set-ratio-a(); } }
                Button { text: "Set B"; enabled: root.selected-band-id >= 0; clicked => { root.set-ratio-b(); } }
            }
    }
}
