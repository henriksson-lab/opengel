# Toupcam / ToupTek Cypress USB cameras supported by OpenGel's userspace backend.
#
# TAG+="uaccess" lets systemd-logind grant access to the active local desktop
# user. GROUP="plugdev" is a fallback for lab workstations and headless setups
# where users are explicitly added to that group.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0547", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="232f", MODE="0660", GROUP="plugdev", TAG+="uaccess"
